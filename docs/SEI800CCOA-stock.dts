        spk_mute-gpios = <0x27 0x1F 0x1>;
        aml-audio-card,dai-link@0 {
            format = "dsp_a";
            mclk-fs = <0x200>;
            bitclock-master = <0xB7>;
            frame-master = <0xB7>;
            suffix-name = "alsaPORT-pcm";
            cpu {
                sound-dai = <0xB7>;
                dai-tdm-slot-tx-mask = <0x1>;
                dai-tdm-slot-rx-mask = <0x1>;
                dai-tdm-slot-num = <0x2>;
                dai-tdm-slot-width = <0x10>;
                system-clock-frequency = <0x3E800>;
                phandle = <0x169>;
            };
